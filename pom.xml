<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mycompany</groupId>
    <artifactId>Parchis</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>18</maven.compiler.source>
        <maven.compiler.target>18</maven.compiler.target>
    </properties>

    <!-- Añade aquí las dependencias de tu proyecto -->

    <build>
        <finalName>${project.artifactId}</finalName>

        <plugins>
            <!-- Ejecutar en desarrollo -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>parchis.Main</mainClass>
                </configuration>
            </plugin>

            <!-- Uber‑jar con todas las dependencias -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>parchis.Main</mainClass>
                                </transformer>
                            </transformers>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>shaded</shadedClassifierName>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Instalador EXE con JVM integrada -->
            <plugin>
                <groupId>org.panteleyev</groupId>
                <artifactId>jpackage-maven-plugin</artifactId>
                <version>1.6.0</version>

                <executions>
                    <execution>
                        <id>bundle-installer</id>
                        <phase>package</phase>
                        <goals><goal>jpackage</goal></goals>
                    </execution>
                </executions>

                <configuration>
                    <!-- Directorio con el jar sombreado -->
                    <input>${project.build.directory}</input>
                    <mainJar>${project.artifactId}-${project.version}-shaded.jar</mainJar>
                    <mainClass>parchis.Main</mainClass>

                    <!-- Tipo de instalador y versión -->
                    <type>EXE</type>
                    <appVersion>1.0.0</appVersion>

                    <!-- Carpeta destino -->
                    <destination>${project.build.directory}</destination>

                    <!-- Metadatos Windows -->
                    <name>${project.artifactId}</name>
                    <vendor>MiEstudio</vendor>
                    <winMenu>true</winMenu>
                    <winShortcut>true</winShortcut>
                    <winDirChooser>true</winDirChooser>
                    <icon>src/main/resources/imagenes/tableroParchis.ico</icon>

                    <!-- <addModules>jdk.crypto.ec,java.sql</addModules> -->
                    <winConsole>false</winConsole>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <name>Parchis</name>
</project>
